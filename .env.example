# Cổng của web Express
PORT=3000

# Địa chỉ json-server (khớp với script "api" trong package.json)
JSON_SERVER_URL=http://localhost:3001

# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model hỗ trợ function calling, ví dụ: gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
